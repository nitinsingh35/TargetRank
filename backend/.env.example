# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/targetrank

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Client Configuration (Frontend URL)
CLIENT_URL=https://your-frontend-vercel-url.vercel.app

# API Base URL (for internal use if needed)
API_URL=https://your-backend-render-url.onrender.com
